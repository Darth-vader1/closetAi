# Copy to .env.local and fill in. Never commit .env.local. Never put real values in this file.

# --- Application ---------------------------------------------------------
# Public base URL, used in auth redirects and email links. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: shown on the /contact page.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Supabase (required) -------------------------------------------------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (anon) key. Safe for the browser; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SERVER ONLY. Bypasses RLS. Needed solely by scheduled email jobs (Phase 5).
# Never expose in client code and never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (optional) ---------------------------------------------------------
# gemini | mock | (leave empty to disable AI; the app then uses manual entry everywhere)
#   gemini: real Google Gemini calls.  mock: labelled development sample data, refused in production.
AI_PROVIDER=
# Create a key in Google AI Studio (https://aistudio.google.com/apikey). Server-only.
AI_API_KEY=
# Model IDs are configuration, not code. Check Google's current model list and pick one that accepts images.
# A "flash-lite" model is cheapest for photo tagging; a larger one is better for styling advice.
AI_VISION_MODEL=
# Optional. Defaults to AI_VISION_MODEL.
AI_TEXT_MODEL=

# --- Email (optional; arrives in Phase 5) ----------------------------------
RESEND_API_KEY=
# A sender on a domain you have verified in Resend, e.g. "ClosetAI <hello@yourdomain.com>"
EMAIL_FROM=

# --- Scheduled jobs (Phase 5) ----------------------------------------------
# Random string of 16+ characters, e.g. `openssl rand -hex 32`. Vercel Cron sends it as a Bearer token.
CRON_SECRET=
