# Copy to .env.local and fill in. Never commit .env.local. Never put real values in this file.

# --- Application ---------------------------------------------------------
# Public base URL, used in auth redirects and email links. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: shown on the /contact page.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Supabase (required) -------------------------------------------------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (anon) key. Safe for the browser; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SERVER ONLY. Bypasses RLS. Needed solely by scheduled email jobs (Phase 5).
# Never expose in client code and never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (optional; arrives in Phase 2) ------------------------------------
# anthropic | openai | mock   ("mock" is a clearly labelled development fallback)
AI_PROVIDER=mock
AI_API_KEY=
# Model names are configuration, not code. Use any vision-capable / text model your provider offers.
AI_VISION_MODEL=
AI_TEXT_MODEL=

# --- Email (optional; arrives in Phase 5) ----------------------------------
RESEND_API_KEY=
# A sender on a domain you have verified in Resend, e.g. "ClosetAI <hello@yourdomain.com>"
EMAIL_FROM=

# --- Scheduled jobs (Phase 5) ----------------------------------------------
# Random string of 16+ characters, e.g. `openssl rand -hex 32`. Vercel Cron sends it as a Bearer token.
CRON_SECRET=
