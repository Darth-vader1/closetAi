# Copy to .env.local and fill in. Never commit .env.local. Never put real values in this file.

# --- PWA / Service Worker --------------------------------------------------
# Suppress Turbopack warning during development (optional)
SERWIST_SUPPRESS_TURBOPACK_WARNING=1

# --- Application ---------------------------------------------------------
# Public base URL, used in auth redirects and email links. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: shown on the /contact page.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Supabase (required) -------------------------------------------------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (anon) key. Safe for the browser; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SERVER ONLY. Bypasses RLS. Needed solely by scheduled email jobs (Phase 5).
# Never expose in client code and never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (optional) ---------------------------------------------------------
# gemini | mistral | groq | mock | (leave empty to disable AI; the app then uses manual entry everywhere)
#   gemini:  Google Gemini API (via AI_API_KEY)
#   mistral: Mistral AI Pixtral vision model (via MISTRAL_API_KEY or AI_API_KEY)
#   groq:    Groq LPU inference (via GROQ_API_KEY or AI_API_KEY)
#   mock:    development sample data, refused in production.
AI_PROVIDER=
# API key from Google AI Studio, Mistral Console, or Groq Console. Supports multiple comma-separated keys for auto-failover.
AI_API_KEY=
# Optional provider-specific keys:
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# Optional model overrides:
AI_VISION_MODEL=
AI_TEXT_MODEL=

# --- Garment Beautification / Segmentation (PhotoRoom API, optional) -------
# Server-side only. Used by /api/ai/beautify for neural garment background removal.
# Obtain at https://www.photoroom.com/api (supports sandbox_... and live sk_pr_... keys)
PHOTOROOM_API_KEY=

# --- Email (Gmail or Resend) -----------------------------------------------
# Option A: Gmail App Password (create at https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=qmyq ihye mcmt zstc
# Option B: Gmail REST API OAuth2 (optional alternative to App Password)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# Option C: Resend
RESEND_API_KEY=
# Optional custom sender display name, e.g. "ClosetAI <youremail@gmail.com>"
EMAIL_FROM=

# --- Scheduled jobs (Phase 5) ----------------------------------------------
# Random string of 16+ characters, e.g. `openssl rand -hex 32`. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# --- WhatsApp Cloud API (optional) -----------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Random secret string configured in Meta App Dashboard > WhatsApp > Configuration > Verify token
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret from Meta App Dashboard > App Settings > Basic > App secret (used to verify X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Verification pepper: random secret string (32+ chars) for hashing verification codes. NEVER expose to clients.
# Generate with: openssl rand -hex 32
WHATSAPP_VERIFICATION_PEPPER=

